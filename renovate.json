{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images used by Testcontainers tests",
      "managerFilePatterns": ["/^services/.+_integration_test\\.go$/", "/^services/.+IT\\.java$/"],
      "matchStrings": ["\"(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "k6 version installed in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": ["k6-version: (?<currentValue>\\S+)"],
      "depNameTemplate": "grafana/k6",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "cosign version installed in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": ["cosign-release: (?<currentValue>\\S+)"],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Maven dependencies"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Base images"
    },
    {
      "matchManagers": ["docker-compose"],
      "groupName": "Local stack images",
      "schedule": ["before 6am on the first day of the month"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": ["postgres", "valkey/valkey", "softwaremill/elasticmq-native"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
